# Copy this file to .env.local and configure for your environment

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL - REQUIRED
NEXT_PUBLIC_API_URL=https://api.testing.example/

# =============================================================================
# App Configuration
# =============================================================================
# Frontend app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# E2E Testing Configuration
# =============================================================================
# Test creator credentials for E2E tests (required for feed CRUD tests)
# Create a test creator account and add credentials here
TEST_CREATOR_EMAIL=testing@example.com
TEST_CREATOR_PASSWORD=************

# =============================================================================
# Optional Configuration
# =============================================================================
# Disable Next.js telemetry (optional)
# NEXT_TELEMETRY_DISABLED=1

# Node environment (set automatically in production)
# NODE_ENV=development
